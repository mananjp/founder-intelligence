{
  "name": "founder-intelligence",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:coverage": "node scripts/check-coverage-ratchet.mjs",
    "db:seed": "tsx db/seed/demo.ts",
    "db:seed:test": "set RUN_DB_SEED_TESTS=1&& vitest run apps/api/test/demoSeed.test.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "next": "15.5.28",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "body-parser": ">=2.4.0",
      "qs": ">=6.16.1",
      "zod": ">=4.6.6"
    }
  }
}
